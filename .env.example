# Copy to .env and fill in real values. Never commit the real .env file.

# Neon Postgres connection string (from neon.tech project dashboard).
DATABASE_URL=

# Auth.js
AUTH_SECRET=
AUTH_TRUST_HOST="true"

# Vercel Blob (attach a Blob store to the Vercel project to get these)
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# Second Blob store used for Asset Approval uploads
ASSETS_STORE_ID=
ASSETS_READ_WRITE_TOKEN=

# Shared secret checked by every /api/cron/* route (Vercel Cron sends this
# automatically as `Authorization: Bearer <CRON_SECRET>`). Generate any long
# random string, e.g. `openssl rand -hex 32`.
CRON_SECRET=

# Anthropic API key, used to summarize pasted Fathom meeting transcripts
# (src/lib/meeting-summary.ts). Get one from console.anthropic.com.
ANTHROPIC_API_KEY=

# AES-256-GCM key for the Client Credentials vault. Generate with
# `openssl rand -base64 32` — must stay a real secret, storing it lost means
# every stored credential becomes unrecoverable.
CREDENTIALS_ENCRYPTION_KEY=

# Slack workspace → Apps → search "Incoming Webhooks" → Add to Slack → pick a
# channel → copy the webhook URL. Every in-app notification also posts here
# (src/lib/notify.ts). Optional — notifications still work in-app-only if
# this is unset, Slack posts just log a warning and skip.
SLACK_WEBHOOK_URL=

# The app's own public URL, used to build absolute links inside Slack
# notification messages (src/lib/notification-links.ts) — Slack has no
# concept of "the current page" the way an in-app click does. Local dev:
# http://localhost:3000. Production: your real Vercel domain.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
