# Copy to .env and fill in real values. Never commit the real .env file.

# Neon Postgres connection string (from neon.tech project dashboard).
# IMPORTANT — this project deliberately keeps two separate databases: a
# "production" Neon branch (the real, live client data) and a "development"
# branch (a Neon branch cloned off production, used for local dev / Preview
# deploys). Local .env and Vercel's Preview + Development environment
# variables should point at the "development" branch's connection string.
# Vercel's Production environment variable is the ONLY place the real
# "production" branch connection string should ever be set. Never point
# local dev at the production branch — that's the exact mistake this split
# exists to prevent.
DATABASE_URL=

# Auth.js
AUTH_SECRET=
AUTH_TRUST_HOST="true"

# Vercel Blob (attach a Blob store to the Vercel project to get these)
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# Second Blob store used for Asset Approval uploads
ASSETS_STORE_ID=
ASSETS_READ_WRITE_TOKEN=

# Shared secret checked by every /api/cron/* route (Vercel Cron sends this
# automatically as `Authorization: Bearer <CRON_SECRET>`). Generate any long
# random string, e.g. `openssl rand -hex 32`.
CRON_SECRET=

# Viktor API key — powers the in-app "Ask Viktor" button (topbar sparkle) via
# src/lib/viktor.ts, which calls Viktor's Public API
# (https://api.viktor.com/api/public/v1). Generate one in Viktor's own
# dashboard: Settings → API Keys → Generate Key. Without this set, the panel
# still opens end-to-end but every reply is a friendly "not connected yet" note.
VIKTOR_API_KEY=

# Bearer token for the read-only agent API at /api/agent/v1/**. Handed to an
# external AI agent (Viktor) so it can answer questions about clients, tasks,
# projects, campaigns, team members, and recent activity — never sees the
# credentials vault, private tasks, HighLevel conversations, or client
# billing/order data. Deliberately its own token (not CRON_SECRET reused) so
# it can be rotated without breaking scheduled jobs.
# Generate the same way: `openssl rand -hex 32`.
AGENT_API_TOKEN=

# Anthropic API key, used to summarize pasted Fathom meeting transcripts
# (src/lib/meeting-summary.ts). Get one from console.anthropic.com.
ANTHROPIC_API_KEY=

# AES-256-GCM key for the Client Credentials vault. Generate with
# `openssl rand -base64 32` — must stay a real secret, storing it lost means
# every stored credential becomes unrecoverable.
CREDENTIALS_ENCRYPTION_KEY=

# Superseded by SLACK_BOT_TOKEN below — every notification now DMs its
# recipient personally instead of posting to one shared channel. Left here
# only so nothing breaks if it's still set; safe to remove once
# SLACK_BOT_TOKEN is live. Do not wire new code to this.
SLACK_WEBHOOK_URL=

# Slack App (api.slack.com/apps → Create New App → From scratch) → OAuth &
# Permissions → Bot Token Scopes: add `chat:write`, `users:read.email`,
# `groups:write` (create/manage each client's private channel), and
# `chat:write.public` (post to the general channel below without being
# invited) → Install to Workspace → copy the "Bot User OAuth Token" (starts
# `xoxb-`). Used by src/lib/slack.ts to DM each notification directly to the
# person it's for (matched by email, or a manually-set Slack ID on their
# Team profile), and to post headline events (workflow handoffs/completion,
# overdue tasks, asset approvals) to a per-client Slack channel — auto-
# created on first use, or manually set on the client's Info page. Optional
# — notifications still work in-app-only if this is unset, or for anyone/
# any client not yet mapped to Slack.
SLACK_BOT_TOKEN=

# One public Slack channel for notifications about internal/client-less work
# (internal workflows, tasks with no client) — create it yourself in Slack,
# then paste its Channel ID here (channel name → "View channel details").
# Used as the fallback destination for src/lib/notify.ts's notifyChannel()
# when there's no client to route to. Optional — those events just don't
# post to any channel if unset (still DM the specific person as normal).
SLACK_INTERNAL_CHANNEL_ID=

# Sentry error tracking (src/app/global-error.tsx, instrumentation*.ts,
# sentry.*.config.ts). Create a free project at sentry.io (platform: Next.js)
# and paste its DSN here — the DSN isn't a secret (it ships in the client
# bundle either way), so one NEXT_PUBLIC_ var covers server/edge/client.
# Optional — error tracking is silently disabled if unset, same pattern as
# every other optional integration in this app.
NEXT_PUBLIC_SENTRY_DSN=

# The app's own public URL, used to build absolute links inside Slack
# notification messages (src/lib/notification-links.ts) — Slack has no
# concept of "the current page" the way an in-app click does. Local dev:
# http://localhost:3000. Production: your real Vercel domain. Also used to
# build the Google Calendar OAuth redirect URI below.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google Calendar OAuth (Team Availability feature, src/lib/google-calendar.ts).
# Google Cloud Console (console.cloud.google.com) → create/select a project →
# APIs & Services → enable the "Google Calendar API" → OAuth consent screen
# (Internal, since this is only for your own Workspace) → scope it to
# `https://www.googleapis.com/auth/calendar.freebusy` only → Credentials →
# Create Credentials → OAuth client ID (Web application) → add
# `${NEXT_PUBLIC_APP_URL}/api/calendar/google/callback` as an authorized
# redirect URI (once for your production domain, once for
# http://localhost:3000/api/calendar/google/callback for local dev) → copy
# the Client ID + Client Secret below. Each team member connects their own
# Google account self-service at /settings/calendar — this app-level
# credential is shared infrastructure, not a per-person login.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
