# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# claude code local harness state
.claude/

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# throwaway verification scripts/pages — created to prove something works
# against real data, then deleted. Ignored so a forgotten one never lands in
# a commit.
_scratch_*
scripts/_scratch_*

# Design reference screenshots (~31 MB of downloaded inspiration images).
# Kept locally for reference only — far too heavy to carry in git history,
# and they're inputs to the UI work, not part of the app.
APP UI UX DESIGN INSPO*/
